<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_empty_state"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl">

    <ImageView
        android:layout_width="@dimen/icon_size_lg"
        android:layout_height="@dimen/icon_size_lg"
        android:contentDescription="@null"
        android:src="@drawable/ic_splash_logo"
        android:tint="@color/color_text_hint" />

    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/empty_data"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
        android:textColor="@color/color_text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retry_empty"
        style="@style/Widget.AnimalLoo.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:text="@string/retry"
        android:visibility="gone" />

</LinearLayout>
