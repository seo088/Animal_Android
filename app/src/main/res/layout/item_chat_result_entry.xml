<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp" app:strokeColor="@color/color_outline" app:strokeWidth="1dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

    <TextView
        android:id="@+id/tv_disease_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/tmoney_round_wind"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle"
        tools:text="가능성이 있는 질환: 급성 장염" />

    <TextView android:id="@+id/tv_result_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:textAppearance="@style/TextAppearance.AnimalLoo.Body" />

    <TextView
        android:id="@+id/tv_probability"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:fontFamily="@font/tmoney_round_wind"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
        android:textColor="@color/color_primary"
        android:textStyle="bold"
        tools:text="문헌 기반 참고 관계" />

    <TextView
        android:id="@+id/tv_related_symptoms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fontFamily="@font/tmoney_round_wind"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
        tools:text="적용 조건: 특정 조건에서 관찰될 수 있습니다." />

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:fontFamily="@font/tmoney_round_wind"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
        android:textColor="@color/color_text_secondary"
        tools:text="추가 확인: 연령, 지속 시간" />

    <TextView
        android:id="@+id/tv_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:autoLink="web"
        android:fontFamily="@font/tmoney_round_wind"
        android:linksClickable="true"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
        android:textColor="@color/color_primary"
        tools:text="출처: Merck Veterinary Manual\nhttps://example.com" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:fontFamily="@font/tmoney_round_wind"
        android:text="@string/diagnosis_caution_label"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
        android:textColor="@color/color_error_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_caution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:fontFamily="@font/tmoney_round_wind"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
        android:textColor="@color/color_error_text"
        tools:text="즉시 수의사 진료를 받으세요." />

    <View
        android:id="@+id/view_result_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:background="@color/color_divider" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>
