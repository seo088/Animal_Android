<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:background="@color/color_surface" android:elevation="3dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="16dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_pet_friendly" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="골든멍타임" android:textAppearance="@style/TextAppearance.AnimalLoo.Title" />
            <View android:layout_width="1dp" android:layout_height="34dp" android:layout_marginStart="18dp" android:layout_marginEnd="8dp" android:background="@color/color_outline" />
            <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar_pet_profile" style="@style/Widget.AnimalLoo.Toolbar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:navigationIcon="@drawable/ic_back" android:title="반려동물 추가하기" app:navigationIconTint="@color/color_primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_go_home" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="홈으로" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" app:backgroundTint="@color/color_primary_light" app:cornerRadius="24dp" app:icon="@drawable/ic_home" app:iconTint="@color/color_primary" />
        </LinearLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="96dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="210dp">
                    <ImageView android:layout_width="96dp" android:layout_height="96dp" android:scaleType="fitCenter" android:src="@drawable/img_pet_match_puppy" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" />
                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_pet_photo" android:layout_width="132dp" android:layout_height="132dp" android:background="@drawable/bg_profile_photo" android:contentDescription="@string/pet_photo_select" android:padding="28dp" android:scaleType="centerInside" android:src="@drawable/ic_profile_placeholder" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimalLoo.Circle" app:strokeColor="@color/color_primary_container" app:strokeWidth="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_pet_photo" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@string/pet_photo_select" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" app:backgroundTint="@color/color_primary" app:cornerRadius="26dp" app:icon="@drawable/ic_camera" app:iconSize="24dp" app:layout_constraintBottom_toBottomOf="@id/iv_pet_photo" app:layout_constraintEnd_toEndOf="@id/iv_pet_photo" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.card.MaterialCardView style="@style/Widget.AnimalLoo.Card.Hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="28dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <include layout="@layout/item_pet_profile_form_fields" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_pet" style="@style/Widget.AnimalLoo.Button" android:layout_width="match_parent" android:layout_height="58dp" android:layout_gravity="bottom" android:layout_margin="20dp" android:text="@string/pet_profile_save" android:textSize="18sp" app:cornerRadius="29dp" app:icon="@drawable/ic_save" app:iconTint="@color/color_surface" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
