<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar_pet_profile" android:layout_width="match_parent" android:layout_height="@dimen/toolbar_height" android:title="@string/pet_profile_title" android:navigationIcon="@drawable/ic_back"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_md">
<ImageView android:id="@+id/iv_pet_photo" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center" android:src="@drawable/img_placeholder" android:scaleType="centerCrop"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_pet_photo" style="@style/Widget.AnimalLoo.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/pet_photo_select"/>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/til_pet_name" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_registration_name"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_name" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_species"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_species" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_registration_breed"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_breed" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_registration_age"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_age" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_gender"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_gender" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_neutered"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_neutered" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout android:id="@+id/til_pet_weight" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_weight"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_weight" android:inputType="numberDecimal" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_birth_date"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_birth_date" android:hint="YYYY-MM-DD" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pet_adoption_date"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_adoption_date" android:hint="YYYY-MM-DD" android:layout_width="match_parent" android:layout_height="wrap_content"/></com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btn_save_pet" style="@style/Widget.AnimalLoo.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pet_profile_save"/>
</LinearLayout></ScrollView></LinearLayout>
