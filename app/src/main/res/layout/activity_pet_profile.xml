<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar_pet_profile" style="@style/Widget.AnimalLoo.Toolbar" android:layout_width="match_parent" android:layout_height="@dimen/toolbar_height" android:title="@string/pet_profile_title" android:navigationIcon="@drawable/ic_back"/>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="96dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp">
   <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="210dp">
    <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/img_pet_match_puppy" android:scaleType="fitCenter" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_pet_photo" android:layout_width="132dp" android:layout_height="132dp" android:background="@drawable/bg_profile_photo" android:contentDescription="@string/pet_photo_select" android:padding="28dp" android:scaleType="centerInside" android:src="@drawable/ic_profile_placeholder" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:shapeAppearanceOverlay="@style/ShapeAppearance.AnimalLoo.Circle" app:strokeColor="@color/color_primary_container" app:strokeWidth="2dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_pet_photo" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="@string/pet_photo_select" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" app:backgroundTint="@color/color_primary" app:cornerRadius="26dp" app:icon="@drawable/ic_camera" app:iconTint="@color/color_surface" app:layout_constraintBottom_toBottomOf="@id/iv_pet_photo" app:layout_constraintEnd_toEndOf="@id/iv_pet_photo"/>
   </androidx.constraintlayout.widget.ConstraintLayout>
   <com.google.android.material.card.MaterialCardView style="@style/Widget.AnimalLoo.Card.Hero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="28dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_pet_name" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="이름 *"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:drawableStart="@drawable/ic_pet_friendly" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/pet_species"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_species" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_profile_placeholder" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="품종 *"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_breed" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_category" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="나이 *"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_age" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:drawableStart="@drawable/ic_calendar" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/pet_gender"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_gender" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_profile_placeholder" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/pet_neutered"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_neutered" android:layout_width="match_parent" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_pet_friendly" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_pet_weight" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/pet_weight"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_weight" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/pet_birth_date"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_birth_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="YYYY-MM-DD" android:inputType="date" android:drawableStart="@drawable/ic_calendar" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/pet_adoption_date"><com.google.android.material.textfield.TextInputEditText android:id="@+id/et_pet_adoption_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="YYYY-MM-DD" android:inputType="date" android:drawableStart="@drawable/ic_favorite" android:drawablePadding="12dp"/></com.google.android.material.textfield.TextInputLayout>
   </LinearLayout></com.google.android.material.card.MaterialCardView>
  </LinearLayout></ScrollView>
 </LinearLayout>
 <com.google.android.material.button.MaterialButton android:id="@+id/btn_save_pet" style="@style/Widget.AnimalLoo.Button" android:layout_width="match_parent" android:layout_height="58dp" android:layout_gravity="bottom" android:layout_margin="20dp" android:text="@string/pet_profile_save" android:textSize="18sp" app:cornerRadius="29dp" app:icon="@drawable/ic_save" app:iconTint="@color/color_surface"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
