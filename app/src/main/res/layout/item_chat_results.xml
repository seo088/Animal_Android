<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_xs">

    <include
        android:id="@+id/chat_bot_avatar"
        layout="@layout/layout_chat_bot_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/tmoney_round_wind"
            android:text="@string/diagnosis_chat_sheet_results_title"
            android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="이 결과는 진단이 아닌 참고 정보입니다.\n질환의 확정이나 발병 가능성을 의미하지 않으며, 정확한 판단은 수의사의 진료가 필요합니다." android:textAppearance="@style/TextAppearance.AnimalLoo.Body" android:textColor="@color/color_text_secondary" />

        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
