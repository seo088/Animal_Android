<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_lg">

            <include android:id="@+id/layout_legacy_pet_card" layout="@layout/layout_home_legacy_pet_card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_personality_title"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Section"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/home_personality_subtitle"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                android:textSize="11sp"
                android:textColor="@color/color_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="vertical">

                <include
                    android:id="@+id/card_personality_recommendation"
                    layout="@layout/item_home_personality" />

                <include
                    android:id="@+id/card_personality_mbti"
                    layout="@layout/item_home_personality" />

                <include
                    android:id="@+id/card_personality_compatibility"
                    layout="@layout/item_home_personality" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/home_life_service_title"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Section"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <include
                    android:id="@+id/card_service_nearby"
                    layout="@layout/item_home_service" />

                <Space
                    android:layout_width="@dimen/spacing_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/card_service_diagnosis"
                    layout="@layout/item_home_service" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <include
                    android:id="@+id/card_service_rescue"
                    layout="@layout/item_home_service" />

                <Space
                    android:layout_width="@dimen/spacing_sm"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/card_service_lost"
                    layout="@layout/item_home_service" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/home_today_status_title"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Section"
                android:textSize="16sp"
                android:visibility="gone" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_stats"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_stat_carousel_height"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/stats_indicator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stats_indicator_height"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@android:color/transparent"
                app:tabBackground="@drawable/selector_stats_dot"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabMaxWidth="@dimen/stats_indicator_height"
                app:tabMinWidth="@dimen/stats_indicator_height"
                app:tabMode="fixed"
                app:tabPaddingBottom="0dp"
                app:tabPaddingEnd="5dp"
                app:tabPaddingStart="5dp"
                app:tabPaddingTop="0dp"
                app:tabRippleColor="@android:color/transparent" />

            <FrameLayout
                android:id="@+id/stats_state_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_alerts_title"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Section"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/alerts_state_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_sm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/card_shadow_inset"
                android:visibility="gone"
                tools:listitem="@layout/item_alert" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
