<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_splash_background"
    tools:context=".ui.splash.SplashActivity">

    <ImageView
        android:id="@+id/iv_splash_dog"
        android:layout_width="@dimen/splash_logo_size"
        android:layout_height="@dimen/splash_logo_size"
        android:layout_gravity="center"
        android:contentDescription="@string/cd_splash_dog"
        android:src="@drawable/ic_dog_splash"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tv_splash_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|bottom"
        android:layout_marginBottom="@dimen/spacing_xxl"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Headline"
        android:textColor="@color/color_on_primary"
        android:visibility="invisible" />

</FrameLayout>
