<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="@dimen/spacing_md">

    <ImageButton
        android:id="@+id/btn_mbti_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_back"
        android:src="@drawable/ic_back"
        app:tint="@color/color_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_mbti_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm"
        android:text="@string/pet_mbti_title"
        android:textAppearance="@style/TextAppearance.AnimalLoo.Headline"
        app:layout_constraintBottom_toBottomOf="@id/btn_mbti_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_mbti_back"
        app:layout_constraintTop_toTopOf="@id/btn_mbti_back" />

    <ScrollView
        android:id="@+id/mbti_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btn_mbti_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_mbti_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_mbti_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/pet_mbti_intro"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_mbti"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="8"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/tv_mbti_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AnimalLoo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:id="@+id/tv_mbti_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Title"
                        android:textColor="@color/color_text_primary" />

                    <RadioGroup
                        android:id="@+id/group_mbti_answers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mbti_result"
                style="@style/Widget.AnimalLoo.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pet_mbti_result_title"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Section" />

                    <TextView
                        android:id="@+id/tv_mbti_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Display"
                        android:textColor="@color/color_primary" />

                    <TextView
                        android:id="@+id/tv_mbti_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="@string/pet_mbti_save_note"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                        android:textColor="@color/color_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_mbti_next"
        style="@style/Widget.AnimalLoo.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="@string/pet_mbti_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
