<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".ui.diagnosis.DiagnosisFragment">

    <LinearLayout android:id="@+id/layout_diagnosis_brand" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_rescue" android:tint="@color/color_primary" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="골든멍타임  |  증상 안내" android:textAppearance="@style/TextAppearance.AnimalLoo.Title" />
        <ImageView android:id="@+id/iv_diagnosis_home" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_profile_photo" android:contentDescription="홈으로 이동" android:padding="9dp" android:src="@drawable/ic_home" android:tint="@color/color_primary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        tools:listitem="@layout/item_chat_bot" />

    <LinearLayout
        android:id="@+id/layout_symptom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/symptom_state_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout android:id="@+id/layout_species_choice" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_species_dog_chat" style="@style/Widget.AnimalLoo.Button.Outlined" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:text="강아지" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_species_cat_chat" style="@style/Widget.AnimalLoo.Button.Outlined" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="고양이" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_symptom_panel_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="지금 보이는 증상을 골라 주세요. 복수 선택할 수 있어요."
            android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
            android:textColor="@color/color_text_secondary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_symptom_selection"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/spacing_xs"
            tools:listitem="@layout/item_symptom_selection" />

        <TextView
            android:id="@+id/tv_selected_symptom_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle"
            android:textColor="@color/color_primary"
            tools:text="선택한 증상 3 / 최대 5개" />

        <HorizontalScrollView
            android:id="@+id/scroll_selected_symptoms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fillViewport="true"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_selected_symptoms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="false" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_symptom_validation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
            android:textColor="@color/color_error_text"
            android:visibility="gone"
            tools:text="증상을 하나 이상 선택해 주세요."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_symptoms"
            style="@style/Widget.AnimalLoo.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="참고 정보 확인하기" />

    </LinearLayout>

</LinearLayout>
