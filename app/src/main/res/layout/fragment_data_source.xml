<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".ui.more.DataSourceFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/data_source_description"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/data_source_mock_notice"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/data_source_list_title"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/data_source_list_body"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:id="@+id/tv_network_info_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_info_banner"
                    android:padding="@dimen/spacing_md"
                    android:text="@string/network_demo_info_banner"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/network_demo_section"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/network_demo_description"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/network_demo_endpoint"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/network_demo_disclaimer"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fetch_public_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/network_demo_fetch" />

                <TextView
                    android:id="@+id/tv_network_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:background="@drawable/bg_empty_state"
                    android:gravity="center"
                    android:padding="@dimen/spacing_md"
                    android:text="@string/network_demo_prompt"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <FrameLayout
                    android:id="@+id/network_state_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_network_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_network_success_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_success"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:text="@string/network_demo_success_badge"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                        android:textColor="@color/color_on_primary" />

                    <TextView
                        android:id="@+id/tv_network_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                        android:textColor="@color/color_primary"
                        tools:text="출처: JSONPlaceholder" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/network_demo_result_notice"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/tv_network_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle"
                        tools:text="데모 응답 제목" />

                    <TextView
                        android:id="@+id/tv_network_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                        android:textColor="@color/color_text_secondary"
                        tools:text="데모 응답 본문" />

                    <TextView
                        android:id="@+id/tv_network_fetched_at"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textAppearance="@style/TextAppearance.AnimalLoo.Caption"
                        tools:text="조회 시각" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
