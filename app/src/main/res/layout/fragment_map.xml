<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" tools:context=".ui.map.MapFragment">

    <FrameLayout android:id="@+id/map_container" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout android:id="@+id/layout_map_fallback" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:paddingHorizontal="@dimen/spacing_md" android:paddingTop="56dp" android:paddingBottom="@dimen/spacing_md" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/tv_map_fallback_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_stat_rescued" android:padding="@dimen/spacing_md" android:text="@string/map_no_api_key" android:textAppearance="@style/TextAppearance.AnimalLoo.Body" android:textColor="@color/color_text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_map_retry" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="@string/map_retry" android:visibility="gone" app:cornerRadius="20dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/map_view_list" android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />
        <FrameLayout android:id="@+id/fallback_state_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_facility_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/spacing_sm" android:layout_weight="1" tools:listitem="@layout/item_facility" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/layout_map_category" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_md" android:layout_marginTop="@dimen/spacing_sm" android:layout_marginEnd="@dimen/spacing_md" app:cardBackgroundColor="@color/color_surface" app:cardCornerRadius="@dimen/corner_radius_xl" app:cardElevation="@dimen/card_elevation_hero" app:strokeColor="@color/color_primary_container" app:strokeWidth="1dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_md">
            <LinearLayout android:id="@+id/layout_map_brand" android:layout_width="match_parent" android:layout_height="40dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@string/cd_app_logo" android:src="@drawable/ic_paw_logo" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:layout_weight="1" android:text="골든멍타임" android:textAppearance="@style/TextAppearance.AnimalLoo.Title" />
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_profile_photo" android:contentDescription="@string/cd_user_profile" android:padding="9dp" android:src="@drawable/ic_profile_placeholder" android:tint="@color/color_primary" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="@dimen/spacing_sm" android:background="@drawable/bg_hero_home" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="@dimen/spacing_md">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="반려동물 지도" android:textAppearance="@style/TextAppearance.AnimalLoo.Headline" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="주변 시설을 한눈에 찾아보세요" android:textAppearance="@style/TextAppearance.AnimalLoo.Caption" />
                </LinearLayout>
                <ImageView android:layout_width="88dp" android:layout_height="88dp" android:contentDescription="@string/cd_splash_dog" android:scaleType="centerInside" android:src="@drawable/img_pet_match_puppy" />
            </LinearLayout>

            <GridLayout android:id="@+id/layout_category_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:columnCount="3" android:rowCount="3">
                <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="전체" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_hospital" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="동물병원" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_pharmacy" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="약국" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_shelter" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="보호소" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_restaurant" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="동반식당" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_cafe" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="동반카페" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_hotel" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="동반숙소" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_tourism" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:layout_width="0dp" android:layout_height="40dp" android:layout_columnWeight="1" android:layout_margin="3dp" android:text="동반관광지" />
            </GridLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout android:id="@+id/map_state_container" android:layout_width="0dp" android:layout_height="wrap_content" android:elevation="8dp" android:paddingHorizontal="@dimen/spacing_md" android:paddingTop="@dimen/spacing_sm" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layout_map_category" />
</androidx.constraintlayout.widget.ConstraintLayout>
