<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/color_background" tools:context=".ui.map.MapFragment">
    <FrameLayout android:id="@+id/map_container" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <LinearLayout android:id="@+id/layout_map_fallback" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="@dimen/spacing_md" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <FrameLayout android:id="@+id/fallback_state_container" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_facility_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" tools:listitem="@layout/item_facility" />
    </LinearLayout>
    <LinearLayout android:id="@+id/layout_map_header" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/color_surface" android:elevation="8dp" android:orientation="vertical" android:paddingStart="@dimen/spacing_md" android:paddingTop="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md" android:paddingBottom="@dimen/spacing_sm" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/map_nearby_title" android:textAppearance="@style/TextAppearance.AnimalLoo.Title" />
        <EditText android:id="@+id/et_map_search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/spacing_sm" android:background="@drawable/bg_map_search" android:hint="@string/map_search_hint" android:imeOptions="actionSearch" android:inputType="text" android:paddingStart="@dimen/spacing_md" android:paddingEnd="@dimen/spacing_md" android:singleLine="true" android:textColor="@color/color_text_primary" android:textColorHint="@color/color_text_hint" android:textSize="14sp" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:clipToPadding="false" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:layout_width="wrap_content" android:layout_height="wrap_content" app:chipSpacingHorizontal="@dimen/spacing_sm" app:singleLine="true">
                <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_all" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_hospital" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_hospital" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_pharmacy" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_pharmacy" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_shelter" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_shelter" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_restaurant" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_restaurant" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_cafe" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_cafe" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_hotel" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_hotel" />
                <com.google.android.material.chip.Chip android:id="@+id/chip_tourism" style="@style/Widget.AnimalLoo.Chip.MapCategory" android:text="@string/map_category_tourism" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>
    <FrameLayout android:id="@+id/map_state_container" android:layout_width="0dp" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layout_map_header" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/card_map_recommendations" android:layout_width="0dp" android:layout_height="210dp" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" android:layout_marginBottom="@dimen/spacing_md" android:visibility="gone" app:cardCornerRadius="@dimen/corner_radius_lg" app:cardElevation="@dimen/card_elevation_hero" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" tools:visibility="visible">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/spacing_md">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/map_recommendation_title" android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/map_recommendation_subtitle" android:textAppearance="@style/TextAppearance.AnimalLoo.Caption" android:textColor="@color/color_text_secondary" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_map_recommendations" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="@dimen/spacing_sm" android:layout_weight="1" tools:listitem="@layout/item_facility" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
