<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".ui.more.SettingsFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.AnimalLoo.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/more_settings"
        app:titleTextColor="@color/color_text_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_account_section"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:id="@+id/tv_account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Title"
                    tools:text="데모 사용자" />

                <TextView
                    android:id="@+id/tv_account_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary"
                    tools:text="demo@animalloo.app" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_retry_account"
                    style="@style/Widget.AnimalLoo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/settings_retry_account"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    style="@style/Widget.AnimalLoo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/settings_logout"
                    android:textColor="@color/color_badge_error"
                    app:strokeColor="@color/color_badge_error" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_notification_section"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:id="@+id/tv_notification_permission_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary"
                    tools:text="알림 권한: 허용됨" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_notification_settings"
                    style="@style/Widget.AnimalLoo.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/settings_open_notification_settings" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_rescue_alert"
                    style="@style/Widget.AnimalLoo.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:minHeight="@dimen/min_touch_target"
                    android:showText="false"
                    android:text="@string/settings_rescue_alert" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_lost_alert"
                    style="@style/Widget.AnimalLoo.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:showText="false"
                    android:text="@string/settings_lost_alert" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_location_alert"
                    style="@style/Widget.AnimalLoo.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/min_touch_target"
                    android:showText="false"
                    android:text="@string/settings_location_alert" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_fcm_section"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:id="@+id/tv_fcm_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary"
                    tools:text="Firebase 미설정" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_test_notification_note"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_rescue_notification"
                    style="@style/Widget.AnimalLoo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/settings_test_rescue_notification" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_lost_notification"
                    style="@style/Widget.AnimalLoo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_test_lost_notification" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_location_notification"
                    style="@style/Widget.AnimalLoo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/settings_test_location_notification" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_cache_section"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:id="@+id/tv_cache_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary"
                    tools:text="분실 신고 사진 캐시: 0 B" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/settings_cache_note"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_photo_cache"
                    style="@style/Widget.AnimalLoo.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/settings_clear_photo_cache" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AnimalLoo.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/more_app_info"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Subtitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/app_tagline"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    android:textColor="@color/color_text_secondary" />

                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textAppearance="@style/TextAppearance.AnimalLoo.Body"
                    tools:text="버전 1.0.0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
