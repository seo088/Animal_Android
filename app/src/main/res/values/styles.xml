<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Typography -->
    <style name="TextAppearance.AnimalLoo.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_display</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <style name="TextAppearance.AnimalLoo.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Card -->
    <style name="Widget.AnimalLoo.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="contentPadding">0dp</item>
        <item name="cardBackgroundColor">@color/color_surface</item>
    </style>

    <style name="Widget.AnimalLoo.Card.Flat" parent="Widget.AnimalLoo.Card">
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Button -->
    <style name="Widget.AnimalLoo.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
    </style>

    <style name="Widget.AnimalLoo.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="strokeColor">@color/color_primary</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <style name="Widget.AnimalLoo.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <!-- Chip -->
    <style name="Widget.AnimalLoo.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">@color/color_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/corner_radius_xl</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
    </style>

    <!-- Switch -->
    <style name="Widget.AnimalLoo.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:showText">false</item>
        <item name="android:textOn">@string/settings_switch_on</item>
        <item name="android:textOff">@string/settings_switch_off</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.AnimalLoo.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.AnimalLoo.BottomNavigationActiveIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.AnimalLoo.BottomNavigationActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_primary_light</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.AnimalLoo.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.AnimalLoo.Subtitle</item>
        <item name="titleTextColor">@color/color_text_primary</item>
        <item name="android:background">@color/color_surface</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
