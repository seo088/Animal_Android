#!/bin/sh
# Strip Cursor co-author trailers so only the human author appears on GitHub.

MSG_FILE="$1"

if [ ! -f "$MSG_FILE" ]; then
    exit 0
fi

# macOS/BSD sed
if sed --version >/dev/null 2>&1; then
    sed -i '/^Co-authored-by: Cursor /d' "$MSG_FILE"
    sed -i '/^Co-authored-by: cursoragent/d' "$MSG_FILE"
else
    sed -i '' '/^Co-authored-by: Cursor /d' "$MSG_FILE"
    sed -i '' '/^Co-authored-by: cursoragent/d' "$MSG_FILE"
fi

exit 0
