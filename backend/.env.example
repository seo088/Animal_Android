# Copy to backend/.env and fill in. `.env` is gitignored.

# PostgreSQL (SQLAlchemy URL, psycopg3 driver)
DATABASE_URL=postgresql+psycopg://animalloo:animalloo@localhost:5432/animalloo

# Apache Jena Fuseki SPARQL query endpoint (dataset: /animalloo)
FUSEKI_QUERY_URL=http://localhost:3030/animalloo/query

# JWT signing secret — use a long random string in any shared environment
JWT_SECRET=change-me
JWT_EXPIRE_HOURS=168

# Uploaded lost-report photos are stored here and served under /uploads
UPLOAD_DIR=uploads
# Base URL the Android app uses to reach this server (emulator → host is 10.0.2.2)
PUBLIC_BASE_URL=http://10.0.2.2:8000

# 공공데이터포털 serviceKey for 농림축산식품부 구조동물(abandonmentPublicService_v2) / 분실동물(lossInfoService) API
ANIMAL_API_KEY=

# 구조·분실동물 OpenAPI를 서버가 자동으로 다시 가져오는 주기(분). 0이면 끔.
SYNC_INTERVAL_MINUTES=60
