## SDK Path
# Copy this file to local.properties and set your Android SDK path.
# sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

## Optional local override for Kakao Map key.
## Recommended setup for team members: copy `.env.example` to `.env` or export KAKAO_MAP_KEY.
# KAKAO_MAP_KEY=YOUR_KAKAO_MAP_KEY_HERE
