# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored and should not be committed.

# Kakao Developers > Native App Key
KAKAO_MAP_KEY=YOUR_KAKAO_MAP_KEY_HERE

# AnimalLoo backend base URL (default: http://10.0.2.2:8000/ = host machine from the emulator)
# API_BASE_URL=http://10.0.2.2:8000/

# true = use the in-app mock repositories instead of the backend
# USE_MOCK_API=false
